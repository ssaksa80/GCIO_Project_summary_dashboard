{
  "name": "gcio-project-summary-dashboard",
  "version": "1.4.0",
  "description": "GCIO Project Intelligence — 24x7 live executive portfolio dashboard with Excel ingestion, C-suite summarization, drill-down, and rich Excel/Word/HTML briefing exports.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "sample-data": "node scripts/generate-sample-data.js",
    "test:db": "node --test test/db/live.test.js",
    "test:ui": "node --test --test-concurrency=1 \"test/ui/**/*.test.js\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "chokidar": "^4.0.3",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.13",
    "docx": "^9.5.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "jose": "^5.10.0",
    "ldapts": "^8.1.8",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.8.0",
    "supertest": "^7.1.1",
    "vite": "^6.3.5"
  }
}
