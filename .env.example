# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8123
HOST=127.0.0.1

# memory = in-process store with the bundled sample portfolio (demos, development)
# mssql  = SQL Server is the system of record (production default)
STORE=memory

# ldap = real directory sign-in. dev = any password, role from DEV_ROLE;
# refused when NODE_ENV=production.
AUTH_MODE=dev
DEV_ROLE=admin

# Directory (AUTH_MODE=ldap)
LDAP_URL=ldaps://dc01.example.local:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_DOMAIN=EXAMPLE
LDAP_UPN_SUFFIX=example.local
LDAP_TIMEOUT_MS=10000

# SQL Server (STORE=mssql). Windows Integrated auth needs no password:
# run the service under a domain account that owns the database.
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=GCIO
DB_WINDOWS_AUTH=true
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Only when DB_WINDOWS_AUTH=false
DB_USER=
DB_PASSWORD=

# Single sign-on (Entra ID). Additive: can run alongside LDAP.
# The browser gets an ID token via MSAL and posts it to /api/auth/sso.
SSO_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Defaults to https://login.microsoftonline.com/<tenant>/v2.0
ENTRA_ISSUER=
# Require the mfa claim in amr. Leave true unless the tenant enforces MFA elsewhere.
ENTRA_REQUIRE_MFA=true
# Optional last-resort key set, used only when the live fetch and the cache both fail.
ENTRA_OFFLINE_JWKS=

# First run only: the directory group installed as admin when dbo.RoleMapping is
# empty. Without it, a fresh database refuses every sign-in — including the
# administrator who would create the first mapping. Ignored once any mapping
# exists, so leaving it set is not a standing back door.
SEED_ADMIN_GROUP=GCIO-Dashboard-Admins

# Sessions
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=240

# Audit JSONL directory, used when STORE=memory (mssql writes to dbo.AuditEvent)
AUDIT_DIR=audit
