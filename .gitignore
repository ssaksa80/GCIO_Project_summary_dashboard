# Dependencies
node_modules/

# Build output — regenerate with: npm run build
client/dist/

# Generated export artifacts (decks, workbooks, briefs, smoke-test output).
# Anchored: an unanchored "exports/" would also swallow any test/exports/.
/exports/

# The CIO briefing is generated from docs/screenshots by its builder, and is
# ~1.9MB per version. Rebuild on demand instead of carrying every re-shoot in
# history:  node scripts/build-briefing.mjs
GCIO_Theme_Selection_Briefing.html

# The watched drop-folder: live portfolio workbooks and the snapshot cache.
# Real portfolio data must never be committed.
data/*
!data/.gitkeep

# Runtime audit output. In production this holds real user principals and
# must never be committed; the SQL store writes to dbo.AuditEvent instead.
# Anchored to the root: unanchored, this also matched test/audit/, which is
# why test/audit/fileAudit.test.js sat untracked and invisible for three
# phases while still running locally.
/audit/

# Ingested workbooks, kept for replay and audit. Real portfolio data.
# Anchored for the same reason as audit/ above.
/vault/

# Release artifacts: staged bundles/patches and their zips. Large (a bundle
# carries the whole node_modules tree plus a Node runtime) and reproducible
# from a release commit, so they are built, not committed.
# Anchored for the same reason as audit/ and vault/ above.
/dist-bundle/

# Local environment
.env

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Cached nssm.exe, seeded by build-bundle.ps1 so an nssm.cc outage cannot
# block a rebuild. Reproducible from versions.json and checksum-verified.
/deploy/.cache/

# Chrome profile directories for the UI suite. Puppeteer is given an explicit
# userDataDir here rather than one under %TEMP%, because it only cleans up its
# own temp profile on a clean browser.close() and this harness tree-kills a
# close that hangs. Anchored for the same reason as audit/ and vault/ above.
/.tmp/
